  "steps": [
    {
      "id": "health",
      "request": "Health / Health",
      "expect": [
        200
      ]
    },
    {
      "id": "demo",
      "request": "Auth / Open demo workspace",
      "expect": [
        200
      ]
    },
    {
      "id": "services",
      "request": "Integrations / Services",
      "expect": [
        200
      ]
    },
    {
      "id": "solana",
      "request": "Integrations / Solana health",
      "expect": [
        200
      ]
    }
  ]
}
