NODE_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/powerchain_copilot
SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
ALLOW_MEMORY_FALLBACK=true
ALLOW_DEMO_AI=true
# Public API security. Store only SHA-256 hashes of API keys here, comma-separated.
API_KEY_REQUIRED=false
POWERCHAIN_API_KEY_HASHES=
PWRC_MINT_ADDRESS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-mini
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_RPC_URL=
HELIUS_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network
BIRDEYE_API_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=

# Development-only diagnostic endpoint. Keep false in production to prevent billing bypass.
ALLOW_UNBILLED_AI_PREVIEW=false

# Recover reserved PWRC credits after a crashed/abandoned response attempt.
CREDIT_RESERVATION_RECOVERY_MS=900000
CREDIT_RECONCILE_INTERVAL_MS=60000
