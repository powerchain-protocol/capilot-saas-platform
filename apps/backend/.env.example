# PowerChain Copilot backend — canonical v1.0.0
NODE_ENV=development
POWERCHAIN_ENV=development
HOST=127.0.0.1
PORT=8000

# Development profile defaults: Solana devnet + Sui devnet.
SOLANA_CLUSTER=devnet
SOLANA_COMMITMENT=confirmed
SUI_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_RPC_URL=
HELIUS_API_KEY=

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional Supabase Realtime/Storage integration. Keep secret keys server-only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_REALTIME_ENABLED=false
SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
ALLOW_MEMORY_FALLBACK=true
ALLOW_DEMO_AI=true
ALLOW_UNBILLED_AI_PREVIEW=false

# Public API security. Store only SHA-256 hashes of API keys here, comma-separated.
API_KEY_REQUIRED=false
POWERCHAIN_API_KEY_HASHES=
PWRC_MINT_ADDRESS=

# AI routing. Providers are tried in this order inside the same governed request.
AI_PROVIDER_ORDER=openai,anthropic,gemini,deepseek,ollama
AI_REQUEST_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
OLLAMA_API_URL=
OLLAMA_MODEL=llama3.3

PYTH_HERMES_URL=https://hermes.pyth.network
BIRDEYE_API_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=

# Recover reserved PWRC credits after a crashed/abandoned response attempt.
CREDIT_RESERVATION_RECOVERY_MS=900000
CREDIT_RECONCILE_INTERVAL_MS=60000
