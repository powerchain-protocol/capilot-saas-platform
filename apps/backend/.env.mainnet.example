# MAINNET TEMPLATE — never commit real secrets.
NODE_ENV=production
POWERCHAIN_ENV=mainnet
HOST=0.0.0.0
PORT=8000

SOLANA_CLUSTER=mainnet-beta
SOLANA_COMMITMENT=confirmed
SUI_NETWORK=mainnet
# Mainnet fails closed without a configured RPC boundary.
SOLANA_RPC_URL=
HELIUS_RPC_URL=
HELIUS_API_KEY=

DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_REALTIME_ENABLED=false

SESSION_SECRET=
CORS_ALLOWED_ORIGINS=https://capilot.powerchain.app,https://capilot.powerchain.energy
COOKIE_DOMAIN=.powerchain.app
COOKIE_SECURE=true
ALLOW_MEMORY_FALLBACK=false
ALLOW_DEMO_AI=false
ALLOW_UNBILLED_AI_PREVIEW=false
API_KEY_REQUIRED=true
POWERCHAIN_API_KEY_HASHES=
PWRC_MINT_ADDRESS=

AI_PROVIDER_ORDER=openai,anthropic,gemini,deepseek,ollama
AI_REQUEST_TIMEOUT_MS=30000
OPENAI_API_KEY=
