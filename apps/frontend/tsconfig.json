{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@powerchain/ai": ["../../packages/ai/src/index.ts"],
      "@powerchain/ai/*": ["../../packages/ai/src/*"],
      "@powerchain/shared": ["../../packages/shared/src/index.ts"],
      "@powerchain/shared/*": ["../../packages/shared/src/*"]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/**/*.ts", "../../packages/**/*.tsx"],
  "exclude": ["node_modules", ".next", "out", "build", "dist"]
}
