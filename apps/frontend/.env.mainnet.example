# MAINNET TEMPLATE — server-only values must be configured in deployment secrets.
NODE_ENV=production

NEXT_PUBLIC_POWERCHAIN_ENV=mainnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SUI_NETWORK=mainnet
NEXT_PUBLIC_APP_URL=https://capilot.powerchain.app
NEXT_PUBLIC_DASHBOARD_URL=/dashboard
NEXT_PUBLIC_SUPPORT_EMAIL=support@powerchain.energy
POWERCHAIN_BACKEND_URL=https://api.capilot.powerchain.energy
POWERCHAIN_API_KEY=
NEXT_PUBLIC_POWERCHAIN_API_URL=https://api.capilot.powerchain.energy/v1
NEXT_PUBLIC_POWERCHAIN_APP_API_URL=https://capilot.powerchain.app/v1
NEXT_PUBLIC_POWERCHAIN_WS_URL=wss://api.capilot.powerchain.energy
NEXT_PUBLIC_POWERCHAIN_WS_PORT=

NEXT_PUBLIC_GITHUB_RELEASE_URL=https://github.com/powerchain-protocol/capilot-frontend/releases
NEXT_PUBLIC_GOOGLE_DRIVE_RELEASE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
POWERCHAIN_TRUSTED_ORIGINS=capilot.powerchain.app

# AI Providers
AI_PRIMARY_PROVIDER=openai
AI_PROVIDER_ORDER=openai,anthropic,gemini,deepseek,ollama
AI_FALLBACK_ENABLED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
