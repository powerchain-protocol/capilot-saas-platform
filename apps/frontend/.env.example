# PowerChain Copilot frontend — canonical v1.0.0
NODE_ENV=development

# Browser / marketing URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=/dashboard
NEXT_PUBLIC_SUPPORT_EMAIL=support@powerchain.energy

# Canonical API v1 backend. The browser uses the same-origin /api/v1 proxy.
POWERCHAIN_BACKEND_URL=http://127.0.0.1:8000

# WebSocket transport cannot use the HTTP proxy upgrade path. Point it at the
# long-lived PowerChain backend. Dev cookies work when frontend and backend use
# the same hostname (for example localhost on different ports).
NEXT_PUBLIC_POWERCHAIN_WS_URL=ws://localhost:8000
NEXT_PUBLIC_POWERCHAIN_WS_PORT=8000

# Distribution channels
NEXT_PUBLIC_GITHUB_RELEASE_URL=https://github.com/powerchain-protocol/capilot-frontend/releases
NEXT_PUBLIC_GOOGLE_DRIVE_RELEASE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Trusted frontend origins for Server Actions. Exact hosts only.
POWERCHAIN_TRUSTED_ORIGINS=localhost:3000
