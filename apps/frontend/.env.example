# PowerChain Copilot frontend — canonical v1.0.0 development profile
NODE_ENV=development
NEXT_PUBLIC_POWERCHAIN_ENV=development
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SUI_NETWORK=devnet

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=/dashboard
NEXT_PUBLIC_SUPPORT_EMAIL=support@powerchain.energy

# Browser uses same-origin /api/v1. This server-only target receives proxy traffic.
POWERCHAIN_BACKEND_URL=http://127.0.0.1:8000
POWERCHAIN_API_KEY=
NEXT_PUBLIC_POWERCHAIN_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_POWERCHAIN_APP_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_POWERCHAIN_WS_URL=ws://localhost:8000
NEXT_PUBLIC_POWERCHAIN_WS_PORT=8000

NEXT_PUBLIC_GITHUB_RELEASE_URL=https://github.com/powerchain-protocol/capilot-frontend/releases
NEXT_PUBLIC_GOOGLE_DRIVE_RELEASE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
POWERCHAIN_TRUSTED_ORIGINS=localhost:3000
