{
  "openapi": "3.1.0",
  "info": {
    "title": "PowerChain Copilot API",
    "version": "1.0.0",
    "description": "Canonical HTTP API for PowerChain Copilot 1.0.0. It provides session-authenticated\nworkspace data, renewable assets, governed approvals, persisted Copilot chats,\nmessage retrieval, AI analysis, provider health, market/network adapters, and\npublic contact/health endpoints. The API uses a consistent `{ ok, data | error }`\nenvelope and signed HttpOnly cookie sessions. AI and network responses do not\nconstitute approval, dispatch, financial advice, transaction confirmation, or\nsettlement evidence.\n",
    "license": {
      "name": "MIT"
    },
    "summary": "Governed SaaS API for PowerChain Copilot renewable-infrastructure operations."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local backend"
    },
    {
      "url": "https://api.powerchain.energy",
      "description": "Production placeholder"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Public API and dependency health."
    },
    {
      "name": "Auth",
      "description": "Registration, sign-in, demo session, and sign-out."
    },
    {
      "name": "Sessions",
      "description": "Session inventory, current identity, revocation, and security metadata."
    },
    {
      "name": "Dashboard",
      "description": "Workspace operational overview."
    },
    {
      "name": "Assets",
      "description": "Renewable infrastructure assets and verification state."
    },
    {
      "name": "Approvals",
      "description": "Human-governed review and mutation boundary."
    },
    {
      "name": "AI",
      "description": "Non-executing AI analysis."
    },
    {
      "name": "Chat",
      "description": "Persisted Copilot chats and compatibility routes."
    },
    {
      "name": "Messages",
      "description": "Immutable message retrieval by opaque ID."
    },
    {
      "name": "Profile",
      "description": "Authenticated user/workspace profile updates."
    },
    {
      "name": "Services",
      "description": "Backend integration configuration status."
    },
    {
      "name": "Markets",
      "description": "Server-side market data adapter."
    },
    {
      "name": "Network",
      "description": "Solana/Helius network adapter health."
    },
    {
      "name": "Contact",
      "description": "Public sales, support, beta, and partnership contact intake."
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "security": [],
        "summary": "API and dependency health",
        "responses": {
          "200": {
            "description": "Health snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthEnvelope"
                }
              }
            }
          }
        },
        "operationId": "getHealth",
        "description": "API and dependency health"
      }
    },
    "/api/v1/auth/sign-in": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "summary": "Sign in and issue a signed session cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rememberMe": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "operationId": "signIn",
        "description": "Sign in and issue a signed session cookie"
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "summary": "Create user, workspace, membership, and session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password",
                  "workspaceName",
                  "acceptedTerms"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12
                  },
                  "workspaceName": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "plan": {
                    "type": "string",
                    "enum": [
                      "free",
                      "pro",
                      "business"
                    ],
                    "default": "free"
                  },
                  "acceptedTerms": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created"
          },
          "409": {
            "description": "Account already exists"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "operationId": "registerAccount",
        "description": "Create user, workspace, membership, and session"
      }
    },
    "/api/v1/auth/demo": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "summary": "Create or enter representative demo workspace",
        "responses": {
          "200": {
            "description": "Demo session created"
          }
        },
        "operationId": "openDemoWorkspace",
        "description": "Create or enter representative demo workspace"
      }
    },
    "/api/v1/auth/sign-out": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Revoke current session and clear cookie",
        "responses": {
          "200": {
            "description": "Signed out"
          }
        },
        "operationId": "signOut",
        "description": "Revoke current session and clear cookie"
      }
    },
    "/api/v1/sessions/current": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Current authenticated session",
        "responses": {
          "200": {
            "description": "Session context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionContextEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "operationId": "getCurrentSession",
        "description": "Current authenticated session"
      }
    },
    "/api/v1/sessions": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "User sessions",
        "responses": {
          "200": {
            "description": "Session list"
          }
        },
        "operationId": "listSessions",
        "description": "User sessions"
      }
    },
    "/api/v1/sessions/{id}": {
      "delete": {
        "tags": [
          "Sessions"
        ],
        "summary": "Revoke a session",
        "parameters": [
          {
            "$ref": "#/components/parameters/EntityId"
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "revokeSession",
        "description": "Revoke a session"
      }
    },
    "/api/v1/security/session": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Security details for current session",
        "parameters": [
          {
            "in": "query",
            "name": "reveal",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            },
            "description": "Reveal the request IP when explicitly set to 1."
          }
        ],
        "responses": {
          "200": {
            "description": "Session security snapshot"
          }
        },
        "operationId": "getSessionSecurity",
        "description": "Security details for current session"
      }
    },
    "/api/v1/dashboard": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Authenticated workspace overview",
        "responses": {
          "200": {
            "description": "Dashboard state"
          }
        },
        "operationId": "getDashboard",
        "description": "Authenticated workspace overview"
      }
    },
    "/api/v1/assets": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Workspace assets",
        "responses": {
          "200": {
            "description": "Assets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Asset"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "listAssets",
        "description": "Workspace assets"
      }
    },
    "/api/v1/approvals": {
      "get": {
        "tags": [
          "Approvals"
        ],
        "summary": "Workspace approval queue",
        "responses": {
          "200": {
            "description": "Approval list"
          }
        },
        "operationId": "listApprovals",
        "description": "Workspace approval queue"
      }
    },
    "/api/v1/approvals/{id}": {
      "post": {
        "tags": [
          "Approvals"
        ],
        "summary": "Approve or request changes",
        "parameters": [
          {
            "$ref": "#/components/parameters/EntityId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "approve",
                      "request_changes"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approval updated"
          },
          "403": {
            "description": "Role or origin rejected"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "updateApproval",
        "description": "Approve or request changes"
      }
    },
    "/api/v1/ai/generate": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Generate governed analysis without persisting a chat message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Managed or deterministic AI response"
          },
          "503": {
            "description": "No AI provider or allowed fallback"
          }
        },
        "operationId": "generateAnalysis",
        "description": "Generate governed analysis without persisting a chat message"
      }
    },
    "/api/v1/chat": {
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "List user chats",
        "responses": {
          "200": {
            "description": "Chat list"
          }
        },
        "operationId": "listChats",
        "description": "List user chats"
      },
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Create a new chat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Chat created"
          }
        },
        "operationId": "createChat",
        "description": "Create a new chat"
      }
    },
    "/api/v1/chat/{id}": {
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "Get chat by opaque id or slug",
        "parameters": [
          {
            "$ref": "#/components/parameters/EntityIdOrSlug"
          }
        ],
        "responses": {
          "200": {
            "description": "Chat and messages"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "getChat",
        "description": "Get chat by opaque id or slug"
      }
    },
    "/api/v1/chat/{id}/messages": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Persist user message and generate Copilot response",
        "parameters": [
          {
            "$ref": "#/components/parameters/EntityIdOrSlug"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assistant message",
            "mode": null,
            "and suggested actions": null
          }
        },
        "operationId": "sendChatMessage",
        "description": "Persist user message and generate Copilot response"
      }
    },
    "/api/v1/copilot": {
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "Compatibility endpoint for current default Copilot chat",
        "responses": {
          "200": {
            "description": "Default chat messages"
          }
        },
        "operationId": "getDefaultCopilotMessages",
        "description": "Compatibility endpoint for current default Copilot chat"
      },
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Compatibility endpoint to send a default Copilot message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assistant response"
          }
        },
        "operationId": "sendDefaultCopilotMessage",
        "description": "Compatibility endpoint to send a default Copilot message"
      }
    },
    "/api/v1/messages/{id}": {
      "get": {
        "tags": [
          "Messages"
        ],
        "summary": "Retrieve one message by opaque message id",
        "parameters": [
          {
            "$ref": "#/components/parameters/EntityId"
          }
        ],
        "responses": {
          "200": {
            "description": "Message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Message"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "getMessage",
        "description": "Retrieve one message by opaque message id"
      }
    },
    "/api/v1/profile": {
      "patch": {
        "tags": [
          "Profile"
        ],
        "summary": "Update profile and workspace display names",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "workspaceName"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2
                  },
                  "workspaceName": {
                    "type": "string",
                    "minLength": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated"
          }
        },
        "operationId": "updateProfile",
        "description": "Update profile and workspace display names"
      }
    },
    "/api/v1/services": {
      "get": {
        "tags": [
          "Services"
        ],
        "summary": "Configured integration catalog",
        "responses": {
          "200": {
            "description": "Service catalog"
          }
        },
        "operationId": "listServices",
        "description": "Configured integration catalog"
      }
    },
    "/api/v1/market/price": {
      "get": {
        "tags": [
          "Markets"
        ],
        "summary": "Read price from configured Pyth or Birdeye adapter",
        "parameters": [
          {
            "in": "query",
            "name": "provider",
            "schema": {
              "type": "string",
              "enum": [
                "auto",
                "pyth",
                "birdeye"
              ],
              "default": "auto"
            }
          },
          {
            "in": "query",
            "name": "feedId",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "address",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Price result"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        },
        "operationId": "getMarketPrice",
        "description": "Read price from configured Pyth or Birdeye adapter"
      }
    },
    "/api/v1/network/solana": {
      "get": {
        "tags": [
          "Network"
        ],
        "summary": "Solana RPC health",
        "responses": {
          "200": {
            "description": "RPC health"
          }
        },
        "operationId": "getSolanaHealth",
        "description": "Solana RPC health"
      }
    },
    "/api/v1/contact": {
      "post": {
        "tags": [
          "Contact"
        ],
        "security": [],
        "summary": "Submit contact, sales, or access request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "message"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "company": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 4000
                  },
                  "intent": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Request stored"
          }
        },
        "operationId": "createContactRequest",
        "description": "Submit contact, sales, or access request"
      }
    },
    "/ws/v1/chat/{id}": {
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "WebSocket endpoint for authenticated chat events",
        "description": "Upgrade this route to WebSocket. Authentication uses the same signed\npc_session cookie. The client falls back to HTTP polling when a\nWebSocket connection is unavailable.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/EntityIdOrSlug"
          }
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols"
          }
        },
        "operationId": "connectChatWebSocket"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pc_session"
      }
    },
    "parameters": {
      "EntityId": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z]{3}_[0-9a-f]{32}$"
        }
      },
      "EntityIdOrSlug": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Validation": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "code"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "HealthEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "data": {
            "type": "object",
            "required": [
              "status",
              "version",
              "timestamp",
              "database",
              "sessions",
              "ai",
              "websocket",
              "providers"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "operational",
                  "degraded"
                ]
              },
              "version": {
                "type": "string",
                "const": "1.0.0"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "database": {
                "type": "object",
                "required": [
                  "ok",
                  "adapter",
                  "latencyMs"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "adapter": {
                    "type": "string"
                  },
                  "latencyMs": {
                    "type": "number"
                  }
                }
              },
              "sessions": {
                "type": "string"
              },
              "ai": {
                "type": "string"
              },
              "websocket": {
                "type": "string"
              },
              "providers": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "plan",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "pro",
              "business"
            ]
