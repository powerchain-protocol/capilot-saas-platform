{
  "name": "powerchain-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "PowerChain Copilot monorepo for renewable-infrastructure AI, SaaS operations, governed actions, and onchain integrations.",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.20.0 <27",
    "pnpm": ">=11.23.0 <12"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "turbo check",
    "clean": "turbo clean && node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "approve-builds": "pnpm approve-builds",
    "frontend": "pnpm --filter @powerchain/capilot-frontend",
    "verify": "pnpm check:source && pnpm typecheck && pnpm lint && pnpm build",
    "doctor": "node scripts/doctor.mjs",
    "check:source": "node scripts/check-source.mjs",
    "ui:add": "pnpm dlx shadcn@latest add",
    "backend": "pnpm --filter @powerchain/capilot-backend",
    "dev:frontend": "pnpm --filter @powerchain/capilot-frontend dev",
    "dev:backend": "pnpm --filter @powerchain/capilot-backend dev",
    "db:migrate": "pnpm --filter @powerchain/capilot-backend db:migrate",
    "api:docs": "pnpm --filter @powerchain/capilot-backend dev",
    "db:check": "pnpm --filter @powerchain/capilot-backend db:check",
    "api:mock": "node api/mocks/server.mjs",
    "sdk:check": "pnpm --filter @powerchain/copilot-sdk check"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.68.0"
  },
  "pnpm": {
    "overrides": {
      "unrs-resolver": "1.12.2"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
