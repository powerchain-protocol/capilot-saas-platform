{
  "name": "powerchain-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "PowerChain Copilot monorepo for renewable-infrastructure AI, SaaS operations, governed actions, and onchain integrations.",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.23.0 <12"
  },
  "scripts": {
    "dev": "pnpm runtime:check && turbo dev",
    "build": "pnpm runtime:check && turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "turbo check",
    "clean": "turbo clean && node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "approve-builds": "pnpm approve-builds",
    "frontend": "pnpm --filter @powerchain/capilot-frontend",
    "verify": "pnpm runtime:check && pnpm deps:policy:check && pnpm postman:remote:verify && pnpm api:generate:check && pnpm check:api-dx && pnpm check:schema && pnpm check:imports && pnpm check:source && pnpm typecheck && pnpm lint && pnpm build",
    "doctor": "node scripts/doctor.mjs",
    "setup:runtime": "bash scripts/bootstrap.sh",
    "check:source": "node scripts/check-source.mjs",
    "ui:add": "pnpm dlx shadcn@latest add",
    "backend": "pnpm --filter @powerchain/capilot-backend",
    "dev:frontend": "pnpm runtime:check && pnpm --filter @powerchain/capilot-frontend dev",
    "dev:backend": "pnpm runtime:check && pnpm --filter @powerchain/capilot-backend dev",
    "db:migrate": "pnpm --filter @powerchain/capilot-backend db:migrate",
    "api:docs": "pnpm api:generate:check && pnpm check:api-dx",
    "db:check": "pnpm --filter @powerchain/capilot-backend db:check",
    "api:mock": "node api/mocks/server.mjs",
    "sdk:check": "pnpm --filter @powerchain/copilot-sdk check",
    "api:generate": "node api/api-generator/generate.mjs",
    "api:generate:check": "node api/api-generator/generate.mjs --check",
    "api:key:hash": "node scripts/hash-api-key.mjs",
    "check:api-dx": "node scripts/check-api-dx.mjs",
    "check:schema": "node scripts/check-schema-snapshot.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "postman:remote": "node scripts/postman-remote.mjs info",
    "postman:remote:verify": "node scripts/postman-remote.mjs verify",
    "postman:spec:pull": "node scripts/postman-remote.mjs pull-spec",
    "postman:spec:push": "node scripts/postman-remote.mjs push-spec",
    "postman:dataset": "node scripts/postman-remote.mjs dataset get",
    "postman:dataset:sources": "node scripts/postman-remote.mjs dataset sources",
    "postman:dataset:views": "node scripts/postman-remote.mjs dataset views",
    "runtime:check": "node scripts/check-runtime.mjs",
    "deps:approve": "pnpm approve-builds",
    "deps:rebuild": "pnpm rebuild unrs-resolver sharp",
    "install:verified": "pnpm runtime:check && pnpm install && pnpm deps:rebuild",
    "deps:policy:check": "node scripts/check-build-policy.mjs",
    "preinstall": "node scripts/check-runtime.mjs"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.68.0"
  }
}
