{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env",
    ".env.local",
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "POWERCHAIN_ENV",
    "SOLANA_CLUSTER",
    "SUI_NETWORK",
    "NEXT_PUBLIC_POWERCHAIN_ENV",
    "NEXT_PUBLIC_SOLANA_CLUSTER",
    "NEXT_PUBLIC_SUI_NETWORK",
    "NEXT_PUBLIC_POWERCHAIN_API_URL",
    "NEXT_PUBLIC_POWERCHAIN_APP_API_URL",
    "NEXT_PUBLIC_POWERCHAIN_WS_URL",
    "VERCEL",
    "VERCEL_ENV",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "eslint.config.*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "*.tsbuildinfo",
        "dist/*.tsbuildinfo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig*.json"
      ]
    },
    "check": {
      "dependsOn": [
        "lint",
        "typecheck"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
