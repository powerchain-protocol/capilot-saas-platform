{
  "name": "@powerchain/supabase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PowerChain Supabase client/config boundary for optional Postgres, Realtime, Storage, and server integrations.",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./server": "./src/server.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "check": "pnpm typecheck && pnpm lint",
    "clean": "node -e \"require('fs/promises').rm('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
